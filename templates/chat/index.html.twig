{% extends 'base.html.twig' %}

{% block title %}Workshop AI – Chat{% endblock %}

{% block body %}
<main class="chat">
    <header class="chat__header">
        <h1>Workshop AI</h1>
        <div class="chat__actions">
            <form method="post" action="{{ path('chat_reset') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('chat_reset') }}">
                <button type="submit" class="button button--ghost">Nieuw gesprek</button>
            </form>
            <form method="post" action="{{ path('chat_delete') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('chat_delete') }}">
                <button type="submit" class="button button--ghost">Wis mijn gesprek</button>
            </form>
        </div>
    </header>

    {% for message in app.flashes('error') %}
        <p class="flash flash--error">{{ message }}</p>
    {% endfor %}
    {% for message in app.flashes('info') %}
        <p class="flash flash--info">{{ message }}</p>
    {% endfor %}

    {# Wat hieronder staat, is exact wat het model bij de volgende vraag te zien krijgt. #}
    {% set last = messages|last %}
    {% if last and last.reply %}
        <p class="chat__context">Context bij het laatste antwoord: {{ last.reply.promptTokens }} tokens</p>
    {% endif %}
    {% if summary %}
        <details class="summary">
            <summary>📦 Samenvatting van het eerdere deel van dit gesprek</summary>
            <p>{{ summary|nl2br }}</p>
        </details>
    {% endif %}

    <section class="chat__messages" aria-live="polite">
        {% for message in messages %}
            <article class="message message--{{ message.role.value }}">
                {% for call in message.reply.toolCalls|default([]) %}
                    <details class="toolcall">
                        <summary>🔧 {{ call.name }}({{ call.input|json_encode }})</summary>
                        <pre>{{ call.result }}</pre>
                    </details>
                {% endfor %}
                <p class="message__text">{{ message.content|nl2br }}</p>
                {% if message.reply %}
                    <footer class="message__meta">
                        {{ message.reply.model }}
                        · in: {{ message.reply.inputTokens }} tokens
                        · uit: {{ message.reply.outputTokens }} tokens
                        {% if message.reply.cacheReadTokens or message.reply.cacheCreationTokens %}
                            · cache: {{ message.reply.cacheReadTokens }} gelezen,
                            {{ message.reply.cacheCreationTokens }} geschreven
                        {% endif %}
                        {% if message.reply.stopReason != 'end_turn' %}
                            · stop: {{ message.reply.stopReason }}
                        {% endif %}
                    </footer>
                {% endif %}
            </article>
        {% else %}
            <p class="chat__empty">Nog geen berichten. Stel een vraag om te starten.</p>
        {% endfor %}
    </section>

    {{ form_start(form, {attr: {class: 'chat__form'}}) }}
        {{ form_row(form.message) }}
        <button type="submit" class="button">Verstuur</button>
    {{ form_end(form) }}

    {# Transparantie (AVG art. 13): wie verwerkt wat, en hoelang. Eén zin, op de plek waar de data vertrekt. #}
    <p class="chat__notice">
        Je vraag gaat naar Anthropic ({{ claude_model }}). E-mailadressen en telefoonnummers maskeren we vóór verzending.
        Gesprekken wissen we automatisch na {{ chat_retention_days }} dagen, of meteen via "Wis mijn gesprek".
    </p>
</main>
{% endblock %}
